  "username_probes": [
    {
      "site": "GitHub",
      "category": "Developer",
      "url": "https://api.github.com/users/{u}",
      "expect_status": 200,
      "not_body": "\"Not Found\""
    },
    {
      "site": "NPM Registry",
      "category": "Developer",
      "url": "https://registry.npmjs.org/-/v1/search?text=maintainer:{u}&size=3",
      "expect_status": 200,
      "must_body": "\"total\":",
      "not_body": "\"total\":0"
    },
    {
      "site": "GitLab",
      "category": "Developer",
      "url": "https://gitlab.com/api/v4/users?username={u}",
      "expect_status": 200,
      "not_body": "[]"
    },
    {
      "site": "Keybase",
      "category": "Crypto/PGP",
      "url": "https://keybase.io/_/api/1.0/user/lookup.json?usernames={u}",
      "expect_status": 200,
      "must_body": "\"them\":[{"
    },
    {
      "site": "HackerNews",
      "category": "Tech",
      "url": "https://hacker-news.firebaseio.com/v0/user/{u}.json",
      "expect_status": 200,
      "not_body": "null"
    },
    {
      "site": "Reddit",
      "category": "Social",
