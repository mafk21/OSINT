{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mafk21/OSINT/blob/main/data/schema.json",
  "title": "OSINT Monster Database Tool Entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "url",
    "category",
    "subcategory",
    "description",
    "type",
    "pricing",
    "opsec",
    "auth_required",
    "inputs",
    "outputs",
    "platforms",
    "tags",
    "tier",
    "quick_start"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case identifier for the tool."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "description": "Canonical name of the OSINT tool, platform, dataset, or framework."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Primary canonical URL (official website or GitHub repository)."
    },
    "github": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "GitHub owner/repo slug if open-source or hosted on GitHub."
    },
    "category": {
      "type": "string",
      "enum": [
        "all-in-one-frameworks",
        "username-enumeration",
        "email-intelligence",
        "phone-messaging-osint",
        "people-public-records",
        "breaches-leaks-stealers",
        "domain-dns-asm",
        "network-ip-iot-search",
        "social-media-socmint",
        "code-cloud-dev-osint",
        "geoint-maps-satellites",
        "image-video-media-forensics",
        "aviation-maritime-transport",
        "corporate-financial-sanctions",
        "crypto-blockchain-web3",
        "darkweb-tor-underground",
        "threat-intel-malware-cti",
        "archiving-evidence-docs",
        "sigint-wireless-space-rf",
        "ai-agents-mcp-opsec"
      ]
    },
    "subcategory": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "type": {
      "type": "string",
      "enum": [
        "CLI",
        "Web Platform",
        "Framework",
        "Search Engine",
        "API / Service",
        "Browser Extension",
        "Desktop App",
        "Dataset / Registry",
        "Library",
        "OS / Distro",
        "AI / MCP"
      ]
    },
    "pricing": {
      "type": "string",
      "enum": [
        "Free / Open Source",
        "Free",
        "Freemium",
        "Paid"
      ]
    },
    "opsec": {
      "type": "string",
      "enum": [
        "Passive",
        "Active",
        "Hybrid"
      ],
      "description": "Passive = queries third-party indexes/public records without touching target; Active = sends direct requests/probes to target; Hybrid = supports both modes."
    },
    "auth_required": {
      "type": "boolean",
      "description": "True if registration, login, or an API key is required for core functionality."
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "username",
          "email",
          "phone",
          "person_name",
          "domain",
          "ip",
          "asn",
          "url",
          "image",
          "video",
          "audio",
          "coordinates",
          "company",
          "crypto_address",
          "file_hash",
          "keyword",
          "vessel_imo",
          "aircraft_hex",
          "vin",
          "mac_bssid",
          "repo_code",
          "onion_url",
          "document",
          "rf_frequency"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "social_profiles",
          "usernames",
          "emails",
          "phones",
          "person_records",
          "subdomains",
          "dns_records",
          "ip_addresses",
          "urls",
          "open_ports",
          "certificates",
          "breach_records",
          "geolocation",
          "satellite_imagery",
          "metadata",
          "whois",
          "corporate_records",
          "sanctions_hits",
          "tx_graph",
          "archived_pages",
          "documents",
          "malware_iocs",
          "flight_tracks",
          "vessel_tracks",
          "darkweb_mentions",
          "tech_stack",
          "secrets",
          "entity_graph",
          "signal_telemetry",
          "opsec_protection"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Web",
          "CLI",
          "Linux",
          "macOS",
          "Windows",
          "Docker",
          "Chrome",
          "Firefox",
          "Python",
          "Go",
          "Rust",
          "Node.js"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "tier": {
      "type": "string",
      "enum": ["S", "A", "B"],
      "description": "S = Flagship industry standard; A = Best-in-class specialist; B = Tactical / regional / niche resource."
    },
    "quick_start": {
      "type": "string",
      "minLength": 5,
      "description": "Install command, CLI example, or concise analyst workflow tip."
    }
  }
}
